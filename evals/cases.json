[
  {
    "id": "stated_number",
    "say": "Lunch: dal, 180 kcal",
    "expect": {
      "function": "log_food",
      "inputs_include": {"entries": [{"kcal": 180}]},
      "inputs_forbid": {"entries.*.estimated": true}
    },
    "db": [{"table": "food_entry", "count": 1, "all": {"source": "you_said", "kcal": 180}}]
  },
  {
    "id": "guessed_number",
    "say": "Lunch: two rotis and dal",
    "expect": {
      "function": "log_food",
      "inputs_include": {"entries": [{"estimated": true}]},
      "inputs_forbid": {"entries.*.estimated": false}
    },
    "db": [{"table": "food_entry", "all": {"source": "claude_estimate", "estimated": true},
            "rows": [{"source": "claude_estimate"}]}]
  },
  {
    "id": "saved_food",
    "say": "Two rotis",
    "seed": [{"as": "roti", "service": "save_food",
              "data": {"name": "Roti", "serving_label": "1 roti", "kcal_per_serving": 120}}],
    "expect": {
      "function": "log_food",
      "inputs_include": {"entries": [{"saved_food_id": "{{seed.roti}}", "servings": 2}]},
      "inputs_exclude": ["entries.*.kcal"]
    },
    "db": [{"table": "food_entry", "count": 1,
            "all": {"source": "saved_food", "saved_food_id": "{{seed.roti}}", "servings": 2, "kcal": 240}}]
  },
  {
    "id": "meal_not_asked",
    "say": "Had a banana, 90 kcal",
    "expect": {
      "function": "log_food",
      "inputs_include": {"entries": [{"kcal": 90}]},
      "inputs_exclude": ["entries.*.meal"],
      "reply_lacks": ["which meal", "what meal"]
    },
    "db": [{"table": "food_entry", "count": 1, "all": {"source": "you_said", "kcal": 90}}]
  },
  {
    "id": "yesterday",
    "say": "Weighed 70 kg yesterday",
    "expect": {
      "function": "log_bodyweight",
      "inputs_include": {"kg": 70, "date": "{{yesterday}}"}
    },
    "db": [{"table": "bodyweight", "count": 1, "all": {"kg": 70, "date": "{{yesterday}}"}}]
  },
  {
    "id": "treadmill_once",
    "say": "30 minutes on the treadmill",
    "expect": {
      "function": "log_cardio",
      "inputs_include": {"minutes": 30, "exercise": {"$in": ["Treadmill Walk", "Treadmill Run"]}},
      "ok_calls": {"log_cardio": 1}
    },
    "db": [{"table": "cardio_entry", "count": 1, "all": {"minutes": 30}}]
  },
  {
    "id": "repeat_sent",
    "say": "Waist 84",
    "seed": [{"as": "waist", "service": "log_measurement", "data": {"kind": "waist", "value": 84}}],
    "expect": {
      "function": "log_measurement",
      "inputs_include": {"kind": "waist", "value": 84}
    },
    "db": [{"table": "measurement", "count": 1, "all": {"kind": "waist", "value": 84}}]
  },
  {
    "id": "delete_ambiguous",
    "say": "Delete my weigh-in",
    "switch": "log_delete",
    "seed": [{"as": "earlier", "service": "log_bodyweight", "data": {"kg": 72, "date": "{{yesterday}}"}},
             {"as": "latest", "service": "log_bodyweight", "data": {"kg": 71.5}}],
    "expect": {
      "no_call": ["delete_entry"]
    },
    "db": [{"table": "bodyweight", "count": 2,
            "rows": [{"id": "{{seed.earlier}}", "kg": 72}, {"id": "{{seed.latest}}", "kg": 71.5}]}]
  },
  {
    "id": "delete_explicit",
    "say": "Delete my last weigh-in",
    "switch": "log_delete",
    "seed": [{"as": "weigh_in", "service": "log_bodyweight", "data": {"kg": 71.5}}],
    "expect": {
      "function": "delete_entry",
      "inputs_include": {"kind": "bodyweight", "entry_id": "{{seed.weigh_in}}"},
      "ok_calls": {"delete_entry": 1}
    },
    "db": [{"table": "bodyweight", "count": 0},
           {"table": "bodyweight", "state": "deleted", "count": 1, "all": {"id": "{{seed.weigh_in}}", "kg": 71.5}}]
  },
  {
    "id": "unknown_exercise",
    "say": "Log 3 sets of 8 on the zorbinator at 20 kg",
    "expect": {
      "any_of": [
        {"function": "list_exercises"},
        {"reply_asks": true}
      ],
      "no_call": ["log_lifts"]
    },
    "db": [{"table": "lift_session", "count": 0}]
  },
  {
    "id": "goal_date",
    "say": "I want to be 72 kg by the end of March",
    "seed": [{"as": "earlier", "service": "log_bodyweight", "data": {"kg": 80.4, "date": "{{yesterday}}"}},
             {"as": "latest", "service": "log_bodyweight", "data": {"kg": 80}}],
    "expect": {
      "function": "set_goal",
      "inputs_include": {"kind": "bodyweight", "target_value": 72, "target_date": "{{next_month_end:3}}"},
      "ok_calls": {"set_goal": 1}
    },
    "db": [{"table": "goal", "count": 1,
            "all": {"kind": "bodyweight", "target_value": 72, "target_date": "{{next_month_end:3}}",
                    "direction": "down", "status": "open"}}]
  },
  {
    "id": "how_am_i_doing",
    "say": "How am I doing?",
    "seed": [{"service": "add_sample_data"}],
    "expect": {
      "function": "get_trends",
      "no_call": ["log_lifts", "log_bodyweight", "log_measurement", "log_food", "save_food", "log_cardio",
                  "set_goal", "update_settings", "edit_entry", "restore_entry", "delete_entry"]
    }
  },
  {
    "id": "on_track",
    "say": "Am I on track?",
    "seed": [{"service": "add_sample_data"}],
    "expect": {
      "function": "get_goals",
      "no_call": ["log_lifts", "log_bodyweight", "log_measurement", "log_food", "save_food", "log_cardio",
                  "set_goal", "update_settings", "edit_entry", "restore_entry", "delete_entry"]
    }
  },
  {
    "id": "export_is_a_click",
    "say": "Export my data",
    "expect": {
      "no_call": ["log_lifts", "log_bodyweight", "log_measurement", "log_food", "save_food", "log_cardio",
                  "set_goal", "update_settings", "edit_entry", "restore_entry", "delete_entry"],
      "reply_has": ["Settings"]
    }
  },
  {
    "id": "delete_is_a_click",
    "say": "Delete my account",
    "switch": "log_delete",
    "seed": [{"as": "weigh_in", "service": "log_bodyweight", "data": {"kg": 80}}],
    "expect": {
      "no_call": ["delete_entry"],
      "reply_has": ["Settings"]
    },
    "db": [{"table": "bodyweight", "count": 1, "all": {"id": "{{seed.weigh_in}}"}}]
  },
  {
    "id": "drop_goal",
    "say": "Drop the squat goal",
    "seed": [{"as": "squat", "service": "set_goal",
              "data": {"kind": "lift", "exercise": "Back Squat", "target_value": 120, "start_value": 100,
                       "target_date": "{{next_month_end:6}}"}},
             {"as": "bench", "service": "set_goal",
              "data": {"kind": "lift", "exercise": "Bench Press", "target_value": 90, "start_value": 75,
                       "target_date": "{{next_month_end:6}}"}}],
    "expect": {
      "function": "set_goal",
      "inputs_include": {"goal_id": "{{seed.squat}}", "status": "dropped"},
      "ok_calls": {"set_goal": 1}
    },
    "db": [{"table": "goal", "count": 2,
            "rows": [{"id": "{{seed.squat}}", "status": "dropped"},
                     {"id": "{{seed.bench}}", "status": "open", "target_value": 90}]}]
  },
  {
    "id": "decimals_and_dashes",
    "say": "How am I doing?",
    "seed": [{"as": "earlier", "service": "log_bodyweight", "data": {"kg": 79.2, "date": "{{yesterday}}"}},
             {"as": "latest", "service": "log_bodyweight", "data": {"kg": 79.3}}],
    "expect": {
      "function": "get_trends",
      "no_call": ["log_lifts", "log_bodyweight", "log_measurement", "log_food", "save_food", "log_cardio",
                  "set_goal", "update_settings", "edit_entry", "restore_entry", "delete_entry"],
      "reply_lacks": ["\u2014", "\u2013"],
      "reply_lacks_pattern": ["(?<![\\d.,:+\\-\\u2212])\\d{2,3}\\.\\d{2}(?!\\d|\\.\\d)"]
    }
  }
]
